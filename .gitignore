!db/migrations/
# db/seed_sample_users.sql stays local (test passwords)
*.sql.gz
*.dump
*.backup

# Notes / credentials kept locally
*.pem
*.key
connect*.txt
secrets*.txt

# Logs and test output
*.log
npm-debug.log*
coverage/

