# Silo environment variables. Copy to .env.local for local development (never commit real values).
# On Vercel, set the same names in Project → Settings → Environment Variables, separately for
# Production, Preview and Development.

# ---------- Supabase (Project Settings → API / API Keys) ----------
# Public: safe in the browser. What a browser can do with them is limited by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# (Older projects: use NEXT_PUBLIC_SUPABASE_ANON_KEY instead of the publishable key.)

# SERVER ONLY. Bypasses RLS. Used for push fan-out, the call sweeper, account deletion and suspensions.
# Never prefix with NEXT_PUBLIC_. (Older projects: SUPABASE_SERVICE_ROLE_KEY.)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------- LiveKit (LiveKit Cloud → Project → Settings → Keys) ----------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=server-only-secret

# ---------- Web Push (VAPID). Generate once: npx web-push generate-vapid-keys ----------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BPublicKeyFromWebPush...
VAPID_PRIVATE_KEY=server-only-private-key
VAPID_SUBJECT=mailto:you@example.com

# ---------- Vercel Cron (daily housekeeping). Any long random string. ----------
CRON_SECRET=generate-a-long-random-string

# Optional: public site address (used in docs/emails; the app itself works from location.origin)
NEXT_PUBLIC_SITE_URL=https://silo.example.com
