# PicknPlay — copy to .env.local (never commit real values).

# PostgreSQL. Local: postgres://postgres@localhost:5432/picknplay
# Hosted (e.g. Supabase): the *transaction pooler* URL (port 6543); SSL is switched on automatically.
DATABASE_URL=postgres://postgres@localhost:5432/picknplay

# Signs the sign-in cookie. 32+ random characters (required in production).
SESSION_SECRET=

# --- Optional services (the app works without them) ---
# Realtime pings via Supabase Realtime broadcast. Without these, phones poll every 1.5 s.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Voice chat at tables (LiveKit Cloud). Also needs the admin switch.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Phone alerts (Web Push). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Daily clean-up job (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
