{
	"id": "/",
	"name": "PicknPlay — card game with friends",
	"short_name": "PicknPlay",
	"description": "PicknPlay — the match-and-shed card game. Classic and Super, with 2–6 friends in real time.",
	"start_url": "/?source=pwa",
	"scope": "/",
	"display": "standalone",
	"display_override": ["standalone", "minimal-ui"],
	"orientation": "any",
	"background_color": "#0A3F29",
	"theme_color": "#0B4A30",
	"categories": ["games", "entertainment"],
	"icons": [
		{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
		{ "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
		{ "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
		{ "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
	],
	"shortcuts": [
		{ "name": "Host a game", "url": "/host", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
		{ "name": "Join a game", "url": "/join", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
		{ "name": "Scores", "url": "/scores", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
	]
}
