  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "livekit-client": "2.23.0",
    "livekit-server-sdk": "2.19.2",
    "next": "15.5.29",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "0.0.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/web-push": "3.6.4",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "repository": {
    "type": "git",
